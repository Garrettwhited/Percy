# Sandbox only. Names only - NEVER put actual credentials in this file,
# in the repo, in Drive, in Devpost, or in chat. Use your secret manager
# or your shell environment.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# Optional live AI recommendation (one bounded call; may have API cost):
# ENABLE_AI=1
# Provider key - either one (if both are set, Gemini is used):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
